
-- DO NOT REMOVE CALL FROM ENGINE 
function spawn_squad(squad_name, smart_name)
    local smart = smart_terrain.smart_terrains_by_name[smart_name]
    sim_board.create_squad(smart, squad_name)
end

function smart_list()
    for k,v in pairs (smart_terrain.smart_terrains_by_name) do 
        
        local name = k
        store_table(v)
        
        local packet = mp_events.gen_event('DEBUG_LOGIC')
        packet:w_stringZ(name);
        mp_events.send_broadcast(packet)

    end
end

